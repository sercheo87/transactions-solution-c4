C4Container
title C4 Nivel 2 - Contenedores de la Banca por Internet BP

Person(cliente, "Cliente BP", "Opera desde navegador o aplicación móvil.")
Person(operador, "Soporte / Cumplimiento", "Accede a funciones administrativas segregadas y auditadas.")

System_Boundary(bp, "Banca por Internet BP") {
    Container_Boundary(canales, "Canales y acceso público") {
        Container(spa, "SPA Banca Web", "React + TypeScript / origen estático privado", "React se elige por ecosistema/talento y composición modular; aplica CSP, accesibilidad, SCA y no expone tokens OAuth al JavaScript.")
        Container(mobile, "Aplicación Móvil", "Flutter", "Flutter se elige por una base de código y UI consistente; valida SDK KYC nativo, secure storage, passkeys, attestation y accesibilidad.")
        Container(frontdoor, "Edge Global", "Azure Front Door Premium + WAF", "Único ingreso público; WAF, TLS, health probes y failover automático entre dos regiones reducen exposición y latencia.")
        Container(apim, "API Gateway", "Azure API Management multi-región", "Valida JWT/scopes, aplica cuotas/rate limit, versiona APIs y propaga correlación; orígenes privados evitan bypass.")
        Container(web_bff, "Web BFF", "Azure Container Apps", "Mantiene sesión web server-side y entrega cookie Secure/HttpOnly/SameSite con control CSRF.")
        Container(mobile_bff, "Mobile BFF", "Azure Container Apps", "Adapta APIs y respuestas a la aplicación móvil; no contiene reglas financieras.")
    }

    Container_Boundary(servicios, "Servicios por bounded context - Hexagonal sobre Container Apps multi-región/multi-zona") {
        Container(customer, "Customer Profile", "Azure Container Apps", "Facade que agrega datos básicos y detalle mediante adaptadores ACL.")
        Container(movements, "Movements Query", "Azure Container Apps", "Consulta movimientos oficiales y usa Cache-Aside/materialized view con frescura explícita.")
        Container(transfers, "Payments & Transfers", "Azure Container Apps", "Valida idempotencia y estado; usa operación atómica del Core o Process Manager interbancario.")
        Container(risk, "Transaction Risk", "Azure Container Apps", "Evalúa límites, fraude y necesidad de step-up MFA con decisión versionada.")
        Container(onboarding, "Onboarding", "Azure Container Apps", "Orquesta consentimiento, KYC, AML, revisión y vinculación con CIAM.")
        Container(notifications, "Notifications", "Azure Container Apps", "Consume eventos confirmados y selecciona canales mediante Strategy, retry y DLQ.")
        Container(audit, "Audit", "Azure Container Apps", "Normaliza y sella eventos auditables; crea proyección consultable y archivo inmutable.")
    }

    Container_Boundary(plataforma, "Datos, integración y operación privados") {
        ContainerDb(postgres, "Datos Operacionales", "PostgreSQL Flexible Server HA zone-redundant + réplica cross-region", "Bases/esquemas aislados por servicio, PITR y failover controlado; estado/idempotencia/Outbox, nunca ledger MAMBO.")
        ContainerDb(redis, "Read Model Cache", "Azure Managed Redis con redundancia", "Caché descartable para clientes frecuentes; su pérdida no afecta integridad y se reconstruye desde MAMBO/eventos.")
        ContainerQueue(servicebus, "Mensajería de Negocio", "Service Bus Premium zone-redundant + Geo-Replication", "Entrega al menos una vez, deduplicación, retry y DLQ; replica metadata/mensajes según RPO.")
        ContainerQueue(eventhubs, "Flujo de Auditoría", "Event Hubs con Geo-Replication de datos", "Streams de ingreso/validado, offsets y consumidores independientes; no se usa Geo-DR solo-metadata cuando el RPO exige eventos.")
        ContainerDb(audit_query, "Consulta de Auditoría", "Cosmos DB / Azure Data Explorer multi-región", "Proyección autorizada y reconstruible; elección final depende de volumen, consulta y costo.")
        ContainerDb(worm, "Archivo de Evidencia", "Blob Storage / ADLS con WORM y réplica aprobada", "Archivo append-only, retención/legal hold y restore test conforme a residencia y política.")
        Container(keyvault, "Secretos y Claves", "Azure Key Vault", "RBAC, purge protection, rotación, acceso privado y claves/certificados.")
        Container(observability, "Observabilidad y SecOps", "Azure Monitor, Application Insights, Log Analytics, Sentinel y Defender", "Métricas, logs, trazas, alertas y respuesta; telemetría sin PII.")
        Container(governance, "Gobierno, Cumplimiento y FinOps", "Azure Policy, Purview, Cost Management y Defender", "Guardrails LOPDP/SB/UAFE, clasificación/retención, presupuestos, tags, alertas de costo, rightsizing y evidencia de cumplimiento.")
    }
}

System_Ext(ciam, "CIAM Corporativo BP", "OIDC/OAuth 2.0, MFA adaptativa y passkeys; Entra External ID es una opción si BP requiere seleccionar producto.")
System_Ext(mambo, "MAMBO - Core Banking", "Sistema externo y fuente oficial de clientes, productos, saldos y movimientos contabilizados.")
System_Ext(cliente_detalle, "Sistema de Detalle de Cliente", "Información complementaria del cliente.")
System_Ext(interbancario, "BCE / Red Interbancaria", "Pagos y transferencias entre entidades; protocolo contractual TBD.")
System_Ext(kyc, "Proveedor KYC Biométrico", "Documento, liveness y face match con sesión efímera.")
System_Ext(aml, "Proveedor AML / Sanciones", "Listas, perfilamiento y señales de riesgo.")
System_Ext(aws_notify, "Notification Service - AWS API Gateway", "Sistema externo principal de notificaciones SMS/email.")
System_Ext(push, "Proveedor Push", "Azure Notification Hubs hacia APNS/FCM.")
System_Ext(alt_notify, "Proveedor Alterno", "Segundo proveedor homologado cuando continuidad requiera independencia cloud.")

