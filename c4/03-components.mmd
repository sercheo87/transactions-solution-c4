C4Component
title C4 Nivel 3 - Componentes Consolidados por Bounded Context

Person(cliente, "Cliente BP", "Usa banca web o móvil.")
Person(operador, "Soporte / Cumplimiento", "Consulta funciones segregadas y evidencia autorizada.")

Container_Ext(spa, "SPA Banca Web", "React + TypeScript", "Canal modular/accesible con CSP/SCA y sin tokens OAuth accesibles al JavaScript.")
Container_Ext(mobile, "Aplicación Móvil", "Flutter", "Base multiplataforma con secure storage, OIDC, passkeys, attestation y captura KYC segura.")
Container_Ext(apim, "Front Door + API Management", "Azure Edge", "WAF, TLS, JWT/scopes, rate limit, versionado y correlación.")

System_Ext(ciam, "CIAM Corporativo BP", "Sistema externo OAuth 2.0/OIDC con MFA, passkeys y administración de identidades.")
System_Ext(mambo, "MAMBO - Core Banking", "Sistema externo y fuente oficial de clientes, productos, saldos y movimientos.")
System_Ext(cliente_detalle, "Sistema de Detalle de Cliente", "Sistema externo con información complementaria del cliente.")
System_Ext(interbancario, "BCE / Red Interbancaria", "Sistema externo para pagos y transferencias entre entidades.")
System_Ext(kyc, "Proveedor KYC Biométrico", "Sistema externo de documento, liveness y face match.")
System_Ext(aml, "Proveedor AML / Sanciones", "Sistema externo de listas y perfilamiento de riesgo.")
System_Ext(aws_notify, "Notification Service - AWS API Gateway", "Sistema externo principal para notificaciones SMS/email.")
System_Ext(push, "Azure Notification Hubs", "Sistema externo administrado para push mediante APNS/FCM.")

ContainerDb(postgres, "Operational Data", "PostgreSQL Flexible Server HA + réplica DR", "Bases/esquemas con ownership por servicio, PITR y failover controlado; workflow, idempotencia, preferencias y Outbox, no ledger.")
ContainerDb(redis, "Read Model Cache", "Azure Managed Redis", "Vista descartable con TTL, versión y frescura; reconstruible desde MAMBO/eventos.")
ContainerQueue(servicebus, "Business Event Bus", "Service Bus Premium HA + Geo-Replication", "Eventos confirmados con entrega al menos una vez, deduplicación, DLQ y réplica de mensajes según RPO.")
ContainerQueue(audit_ingress, "Audit Ingress", "Event Hubs HA + Geo-Replication", "Acciones, accesos y decisiones sanitizadas con consumer groups/checkpoints.")
ContainerQueue(audit_validated, "Validated Audit Stream", "Event Hubs HA + Geo-Replication", "Eventos normalizados/sellados y replicados según RPO, listos para captura/proyección.")
ContainerDb(audit_query, "Audit Query Store", "Cosmos DB / Azure Data Explorer", "Proyección autorizada y reconstruible.")
ContainerDb(worm, "Immutable Evidence Archive", "Blob Storage / ADLS WORM", "Evidencia append-only con retención y legal hold aprobados.")
Container(observability, "Observability / SecOps", "Azure Monitor + Application Insights + Sentinel + Defender", "Métricas, logs, trazas y alertas sin PII.")
Container(governance, "Security, Compliance and FinOps Guardrails", "Azure Policy + Purview + Cost Management", "LOPDP, SB/UAFE, OWASP, privacidad, retención, tags, budgets, rightsizing y control de configuración.")

Container_Boundary(access, "BFF y Capa de Acceso - Interface Adapters") {
    Component(web_session, "Web Session BFF", "OIDC Confidential Client", "Ejecuta Authorization Code + PKCE; conserva tokens server-side y emite cookie Secure/HttpOnly/SameSite con CSRF.")
    Component(mobile_bff, "Mobile BFF", "REST Adapter", "Adapta APIs al canal móvil sin reglas financieras.")
    Component(api_router, "API Authorization Router", "JWT / Scope Policy", "Propaga sujeto, scopes y correlationId a los casos de uso autorizados.")
    Component(access_audit, "Access Audit Publisher", "Event Hubs Adapter", "Publica login, acceso y resultado sin credenciales, tokens ni PII innecesaria.")
}

Container_Boundary(customer_movements, "Customer Profile y Movements Query") {
    Component(profile_api, "Customer and Movements API", "REST Driving Adapter", "Valida ownership de cliente/cuenta, rango y paginación.")
    Component(profile_facade, "Customer Profile Facade", "Application Use Case", "Agrega datos básicos y detalle, preserva procedencia y permite degradación controlada.")
    Component(profile_domain, "Customer Profile Model", "Domain Model", "Modelo canónico BP con minimización y clasificación de datos.")
    Component(mambo_customer_acl, "MAMBO Customer ACL", "Anti-Corruption Layer", "Traduce datos/productos MAMBO con timeout, circuit breaker y bulkhead.")
    Component(detail_acl, "Customer Detail ACL", "Anti-Corruption Layer", "Traduce el sistema complementario y controla respuesta parcial.")
    Component(mov_query, "Get Movements Use Case", "CQRS Read Side", "Devuelve movimientos oficiales con fuente y frescura explícitas.")
    Component(cache_policy, "Cache-Aside Policy", "Application Policy", "Evalúa TTL/versión; ante miss o pérdida reconstruye desde MAMBO.")
    Component(redis_adapter, "Redis Read Model Adapter", "Infrastructure Adapter", "Persiste solamente la vista mínima y descartable.")
    Component(mov_mambo_acl, "MAMBO Movements ACL", "Anti-Corruption Layer", "Consulta el histórico oficial y protege la dependencia externa.")
    Component(projector, "Movement Projection Consumer", "Idempotent Consumer", "Consume eventos confirmados y actualiza/invalida la vista sin duplicar efectos.")
}

Container_Boundary(transfers, "Payments & Transfers") {
    Component(transfer_api, "Transfer API Adapter", "REST Driving Adapter", "Valida scope, payload, idempotencyKey y correlationId.")
    Component(submit_transfer, "Submit Transfer Use Case", "Application Service", "Orquesta la orden sin depender de MAMBO, red, base o cloud.")
    Component(idempotency, "Idempotency Policy", "Application Policy", "Evita doble débito/instrucción ante retry y concurrencia.")
    Component(transfer_domain, "Transfer Aggregate", "Domain Model / State Machine", "Protege invariantes y estados RECEIVED, VALIDATED, SUBMITTED, ACCEPTED, REJECTED, UNKNOWN y RECONCILED.")
    Component(risk_policy, "Transaction Risk Policy", "Domain Service", "Evalúa límites, fraude y necesidad de step-up MFA con decisión versionada.")
    Component(process_manager, "Interbank Process Manager", "Saga / State Machine", "Coordina flujo interbancario; una liquidación requiere reverso financiero, no rollback técnico.")
    Component(transfer_repo, "Transfer Repository", "PostgreSQL Adapter", "Persiste agregado, estado y control de idempotencia.")
    Component(outbox, "Transactional Outbox", "Outbox Adapter", "Guarda evento y estado en la misma transacción local.")
    Component(dispatcher, "Outbox Dispatcher", "Background Worker", "Publica eventos pendientes con retry, deduplicación y métricas de lag.")
    Component(mambo_transfer_acl, "MAMBO Transfer ACL", "Anti-Corruption Layer", "Contabiliza/consulta con ID oficial, timeout, circuit breaker, bulkhead e idempotencia.")
    Component(interbank_acl, "Interbank ACL", "Anti-Corruption Layer", "Traduce el contrato B2B; ISO 20022 solo si el contrato lo exige.")
    Component(reconciler, "Reconciliation Worker", "Scheduled Use Case", "Resuelve UNKNOWN consultando referencias externas; nunca reintenta el débito a ciegas.")
}

Container_Boundary(onboarding, "Onboarding y KYC") {
    Component(onb_api, "Onboarding API Adapter", "REST Driving Adapter", "Valida sesión, estado esperado, idempotencia y payload minimizado.")
    Component(onb_workflow, "Onboarding Workflow", "Application Process Manager", "Orquesta consentimiento, KYC, MAMBO, AML, revisión y CIAM.")
    Component(identity_policy, "Identity and Privacy Policy", "Domain Policy", "Combina consentimiento, liveness, documento, face match, attestation y resultado REVIEW.")
    Component(kyc_acl, "KYC Provider Adapter", "Anti-Corruption Layer", "Crea sesión efímera y valida callback firmado; no guarda imagen/video.")
    Component(onb_mambo_acl, "MAMBO Customer Adapter", "Anti-Corruption Layer", "Valida/vincula el cliente oficial sin replicar el maestro.")
    Component(aml_acl, "AML Provider Adapter", "Anti-Corruption Layer", "Traduce listas/score y escala incertidumbre a revisión.")
    Component(ciam_acl, "CIAM Provisioning Adapter", "OIDC / Admin API Adapter", "Crea/vincula identidad solamente después de aprobación.")
    Component(onb_repo_outbox, "Onboarding Repository + Outbox", "PostgreSQL Adapter", "Persiste workflow, consentimiento, referencias y evento; nunca biometría cruda.")
}

Container_Boundary(notifications, "Notifications") {
    Component(notification_consumer, "Notification Event Consumer", "Idempotent Consumer", "Consume únicamente eventos confirmados y tolera redelivery.")
    Component(notification_policy, "Notification Policy", "Domain Policy", "Decide obligatoriedad, prioridad, preferencias y datos permitidos por canal.")
    Component(channel_router, "Channel Router", "Strategy", "Selecciona AWS SMS/email o push según política y salud.")
    Component(aws_adapter, "AWS Notification Adapter", "HTTPS Adapter", "Invoca el sistema externo Notification Service - AWS API Gateway con circuit breaker y credencial rotada.")
    Component(push_adapter, "Push Adapter", "Notification Hubs Adapter", "Envía alerta sin saldo ni cuenta completa en pantalla bloqueada.")
    Component(notification_retry, "Retry / DLQ Worker", "Background Worker", "Aplica backoff/jitter, límite de intentos y poison handling.")
}

Container_Boundary(audit, "Audit - Append-only Audit Trail; no Event Sourcing financiero") {
    Component(audit_consumer, "Audit Ingestion Consumers", "Service Bus + Event Hubs Adapters", "Consume eventos de dominio y acceso con deduplicación/checkpoints.")
    Component(audit_normalizer, "Audit Normalizer", "Application Component", "Normaliza versión, actor seudonimizado, acción, resultado, tiempo y correlación.")
    Component(privacy_validator, "Schema and Privacy Validator", "Domain Policy", "Rechaza secretos, tokens, CVV, biometría y PII innecesaria.")
    Component(integrity, "Integrity Stamper", "Domain Service", "Calcula hash/sello para detectar alteración.")
    Component(validated_publisher, "Validated Audit Publisher", "Event Hubs Adapter", "Publica únicamente eventos aprobados al stream de evidencia.")
    Component(audit_projector, "Audit Projection Writer", "Idempotent Consumer", "Actualiza vista consultable y reconstruible por eventId.")
    Component(audit_api, "Audit Query API", "REST Driving Adapter", "Aplica RBAC/SoD, MFA/PIM, propósito y audit-of-audit.")
}

